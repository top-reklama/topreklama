# Copy to .env.local for local development; on Vercel set these in Project → Settings → Environment Variables.

# Database (Turso). Without it, local development uses the file .data/local.db.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=

# File storage (Vercel Blob, private store). Added automatically when you connect a Blob store to the project.
# Without it, local development stores uploads in .data/blobs.
BLOB_READ_WRITE_TOKEN=

# Admin sign-in at /admin. SESSION_SECRET must be at least 32 random characters.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
SESSION_SECRET=

# Public address and search indexing (see README, Preview mode and launch).
SITE_URL=https://your-project.vercel.app
SITE_INDEXING=off

# Optional: email alerts for new requests (see README, Request notifications).
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=

# Optional: read-only production export (see README, Production handoff).
PRODUCTION_API_TOKEN=
